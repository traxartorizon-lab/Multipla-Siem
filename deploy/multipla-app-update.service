[Unit]
Description=Multipla SIEM - atualizacao assinada solicitada pelo Superadmin
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/multipla-update
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /usr/local/lib/multipla-siem /var/lib/multipla-siem /var/backups/multipla-siem /run
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
LimitCORE=0
StandardOutput=journal
StandardError=journal
