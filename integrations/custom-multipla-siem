#!/usr/bin/env python3
"""Wazuh Integrator: arquivo de alerta, api_key, hook_url. Sem pacotes pip."""
import json
import sys
import time
import urllib.error
import urllib.request
from urllib.parse import urlparse

def main():
    if len(sys.argv) < 4:
        raise ValueError('Uso: custom-multipla-siem ALERT_FILE INGEST_TOKEN HTTPS_HOOK_URL')
    path, key, endpoint = sys.argv[1:4]
    u = urlparse(endpoint)
    if u.scheme != 'https' or not u.hostname or u.username or u.password:
        raise ValueError('hook_url deve usar HTTPS válido')
    with open(path, 'rb') as stream:
        payload = stream.read(65537)
    if len(payload) > 65536:
        raise ValueError('Alerta excede 64 KB')
    json.loads(payload)
    for attempt in range(3):
        req = urllib.request.Request(endpoint, data=payload, method='POST', headers={
            'Authorization': 'Bearer ' + key,
            'Content-Type': 'application/json',
        })
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                if resp.status == 200:
                    return
        except urllib.error.HTTPError as err:
            if err.code < 500 and err.code != 429:
                raise ValueError('SIEM rejeitou alerta: HTTP ' + str(err.code)) from None
        except urllib.error.URLError:
            pass
        if attempt < 2:
            time.sleep(2 ** attempt)
    # Sem spool permanente: deixe a falha no integrator.log para reenvio operacional.
    raise RuntimeError('SIEM indisponível após 3 tentativas; consulte integrator.log')

if __name__ == '__main__':
    try:
        main()
    except Exception as err:
        # Não registre key, URL com segredo ou conteúdo sensível do alerta.
        print('Multipla Siem integration failed: ' + type(err).__name__, file=sys.stderr)
        sys.exit(1)
